{
  "name": "isv-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "concurrently -k -n client,server -c cyan,magenta \"vite\" \"npm:server\"",
    "server": "node --watch-path=server --watch-path=src --watch-path=maps node_modules/vite-node/dist/cli.mjs server/main.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "start:server": "node dist-server/main.js",
    "preview": "vite preview",
    "sim": "vite-node scripts/sim.ts",
    "screenshots": "vite-node scripts/screenshots.ts",
    "sfx": "vite-node scripts/sfx.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "check": "npm run typecheck && npm run lint && npm run test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@colyseus/sdk": "^0.18.5",
    "colyseus": "^0.18.9",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
