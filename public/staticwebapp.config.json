{
  "routes": [
    {
      "route": "/assets/sfx/*",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/assets/music/*",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/index.html",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/",
      "headers": { "cache-control": "no-cache" }
    }
  ],
  "mimeTypes": {
    ".ogg": "audio/ogg"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
